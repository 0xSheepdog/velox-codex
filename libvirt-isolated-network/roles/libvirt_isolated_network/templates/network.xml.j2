<network>
  <name>{{ libvirt_net_name }}</name>
  <forward mode='nat'>
    <nat>
      <port start='{{ libvirt_net_nat_port_start }}' end='{{ libvirt_net_nat_port_end }}'/>
    </nat>
  </forward>
  <bridge name='{{ libvirt_net_bridge }}' stp='on' delay='0'/>
  <ip address='{{ libvirt_net_host_ip }}' netmask='{{ libvirt_net_netmask }}'>
{% if libvirt_net_dhcp_enabled %}
    <dhcp>
      <range start='{{ libvirt_net_dhcp_range_start }}' end='{{ libvirt_net_dhcp_range_end }}'/>
    </dhcp>
{% endif %}
  </ip>
</network>
