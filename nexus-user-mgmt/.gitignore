# Keep the CSV and TXT templates tracked; ignore any others dropped in files/
files/*
!files/users_template.csv
!files/role_privileges_template.txt

# Project-local collections.
# Installed via: ansible-galaxy collection install -r requirements.yml -p ./collections
collections/

# Ansible transients
*.retry
.ansible/

# Vault password files (operators may keep these locally)
.vault_pass
*.vaultpass

# Editor cruft
.vscode/
.idea/
*.swp
